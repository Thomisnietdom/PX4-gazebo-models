      <maxRotVelocity>3200</maxRotVelocity>
      <motorConstant>1.0e-05</motorConstant>
      <momentConstant>0.01</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber>
